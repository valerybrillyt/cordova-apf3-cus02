<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · Córdova</title>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="stylesheet" href="/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <header class="encabezado">
    <div class="container encabezado-interno">
      <div>
        <p class="marca">Pastelería-Cafetería Córdova</p>
        <p class="sede">Local sede Chifa · Registro de pedidos</p>
      </div>
      <% if (usuario) { %>
        <form method="post" action="/logout" class="sesion">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span class="quien"><%= usuario.identificadorAcceso %></span>
          <button type="submit" class="btn btn-sm btn-outline-light">Cerrar sesión</button>
        </form>
      <% } %>
    </div>
  </header>
  <main class="container py-4">
